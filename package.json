{
  "name": "car-care-app",
  "version": "1.5.0",
  "description": "Sistema para talleres con sincronización segura en Supabase",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "webpack --mode=production",
    "build:web": "cross-env BUILD_TARGET=web webpack --mode=production",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "copy-webpack-plugin": "13.0.0",
    "cross-env": "7.0.3",
    "css-loader": "^7.1.2",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "html-webpack-plugin": "^5.6.3",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.7",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@electron/remote": "2.1.3",
    "@supabase/supabase-js": "2.57.4",
    "global": "^4.4.0",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "6.30.6"
  },
  "overrides": {
    "crc-32": "1.2.2"
  },
  "build": {
    "appId": "com.carcare.app",
    "productName": "Car Care Taller",
    "directories": { "buildResources": "assets", "output": "release" },
    "files": ["dist/**/*", "main.js", "package.json", "public/**/*"],
    "win": { "target": "nsis", "icon": "assets/icon.ico" }
  }
}
